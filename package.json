    "ast-compression",
    "ai-agent"
  ],
  "author": "Tokenist Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.17",
    "@types/vscode": "^1.80.0",
    "react": "^19.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^1.4.2",
    "ignore": "^7.0.6",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  }
}

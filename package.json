{
  "name": "shanaxon-mcp",
  "version": "6.1.0",
  "description": "Shanaxon: Open-Source Local Context Optimization & FinOps Layer for AI Coding Agents",
  "main": "dist/index.js",
  "bin": {
    "shanaxon": "dist/index.js",
    "shanaxon-mcp": "dist/index.js",
    "shanaxon-init": "dist/cli/init.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "!dist/validation",
    "!dist/validation/**",
    "!dist/core/verify*.js",
    "!dist/core/test_component.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && ts-node src/core/copy_assets.ts",
    "start": "node dist/index.js",
    "benchmark": "ts-node src/core/benchmarkReal.ts",
    "init": "ts-node src/cli/init.ts",
    "export": "ts-node src/cli/export.ts",
    "validate": "ts-node src/validation/realWorldBenchmark.ts",
    "validate:real": "ts-node src/validation/realProviderExperiment.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shanaxon",
    "mcp",
    "model-context-protocol",
    "context-optimization",
    "finops",
    "claude-code",
    "antigravity",
    "tree-sitter",
    "ast-compression",
    "llm"
  ],
  "author": "Shanaxon Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.17",
    "@types/vscode": "^1.80.0",
    "react": "^19.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^1.4.2",
    "ignore": "^7.0.6",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  }
}

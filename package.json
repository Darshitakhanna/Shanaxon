{
  "name": "tokenist-optimizer",
  "version": "1.0.1",
  "description": "Tokenist: Open-Source Local Token Optimizer Layer for AI Agents",
  "main": "dist/index.js",
  "bin": {
    "tokenist-optimizer": "dist/index.js",
    "tokenist": "dist/index.js",
    "tokenist-init": "dist/cli/init.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && ts-node src/core/copy_assets.ts",
    "start": "node dist/index.js",
    "benchmark": "ts-node src/core/benchmarkReal.ts",
    "init": "ts-node src/cli/init.ts",
    "export": "ts-node src/cli/export.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "token-optimization",
    "context-window",
    "claude-code",
    "antigravity",

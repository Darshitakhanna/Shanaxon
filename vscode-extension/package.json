{
  "name": "shanaxon-vscode",
  "displayName": "Shanaxon — Context & FinOps Optimizer",
  "description": "Local context compression and real-time token savings dashboard for AI agent platforms (Claude Code, Antigravity, Kiro)",
  "version": "1.0.0",
  "publisher": "shanaxon",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shanaxon.showDashboard",
        "title": "Shanaxon: Show Analytics Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "shanaxon.init",
        "title": "Shanaxon: Initialize Workspace (.shanaxon.json)",
        "icon": "$(tools)"
      },
      {
        "command": "shanaxon.reindex",
        "title": "Shanaxon: Force Re-index Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "shanaxon.runBenchmark",
        "title": "Shanaxon: Run Codebase Benchmark",
        "icon": "$(dashboard)"
      }
    ],
    "configuration": {
      "title": "Shanaxon",
      "properties": {
        "shanaxon.defaultTier": {
          "type": "string",
          "default": "aggressive",
          "enum": [
            "normal",
            "medium",
            "aggressive"
          ],
          "description": "Default compression tier used by Shanaxon MCP server."
        },
        "shanaxon.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show token savings status bar item."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.9.3"
  }
}
